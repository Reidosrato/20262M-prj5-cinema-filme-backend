datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Filme {
  idFilme        Int       @id @default(autoincrement()) @map("filme_id") @db.UnsignedInt
  titulo         String    @map("filme_titulo") @db.VarChar(255)
  sinopse        String?   @map("filme_sinopse") @db.Text
  classificacao  String?   @map("filme_classificacao_indicativa") @db.VarChar(10)
  duracaoMinutos Int       @map("filme_duracao") @db.UnsignedSmallInt
  genero         String?   @map("filme_genero") @db.VarChar(100)
  idioma         String?   @map("filme_idioma") @db.VarChar(50)
  dataLancamento DateTime? @map("filme_data_lancamento") @db.Date
  trailer        String?   @map("filme_trailer_url") @db.VarChar(500)
  status         Int       @map("filme_status")

  @@map("filme")
}
